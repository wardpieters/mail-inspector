APP_NAME="Mail Inspector"
APP_ENV=production
APP_LOCALE=en_US
APP_FALLBACK_LOCALE=en_US
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8080
PRIVACY_CONTACT_NAME="John Doe"
PRIVACY_CONTACT_EMAIL=john@example.com
HTTP_BIND=127.0.0.1
HTTP_PORT=8080
LOG_CHANNEL=stderr
LOG_LEVEL=info
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=mail_inspector
DB_USERNAME=mail_inspector
DB_PASSWORD=
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
CACHE_STORE=redis
QUEUE_CONNECTION=redis
REDIS_QUEUE_RETRY_AFTER=300
SESSION_DRIVER=redis
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=false
SCAN_DNS_SERVER=unbound
SCAN_DNS_PORT=53
SCAN_DNS_TRUSTED=true
SCAN_HELO=scanner.example.com
SCAN_SENDER=
SCAN_RELAY_SENDER=
SCAN_RELAY_RECIPIENT=
SCAN_CA_FILE=
SCAN_SECONDS=300
SCAN_ENDPOINT_SECONDS=30
SCAN_RETENTION_DAYS=7
TRUSTED_PROXIES=
