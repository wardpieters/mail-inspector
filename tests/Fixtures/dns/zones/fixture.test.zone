$ORIGIN ZONE_NAME.
$TTL 60
@ IN SOA ns.ZONE_NAME. hostmaster.ZONE_NAME. (1 60 60 3600 60)
@ IN NS ns.ZONE_NAME.
ns IN A 127.0.0.1
@ IN MX 10 mx.ZONE_NAME.
mx IN A 8.8.8.8
mx IN AAAA 2606:4700:4700::1111
@ IN TXT "v=spf1 " "-all"
@ IN CAA 0 issue "letsencrypt.org"
_dmarc IN TXT "v=DMARC1; p=reject; psd=n"
_25._tcp.mx IN TLSA 3 1 1 AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
